# Debug Configuration
DEBUG=false

# System Configuration
# Interval between charging checks in minutes (default: 5 minutes)
CHECK_INTERVAL_MINUTES=5

# Sunny Portal / ennexOS Configuration (data + control via the uiapi.sunnyportal.com REST API)
SUNNY_PORTAL_USERNAME=your-sunny-portal-username
SUNNY_PORTAL_PASSWORD=your-sunny-portal-password
SUNNY_PORTAL_URL=https://www.sunnyportal.com/
# ennexOS plant/component id (defaults to 17318995 if unset)
ENNEXOS_PLANT_ID=17318995

# Solar generation forecast (forecast.solar). ennexOS does not expose a PV forecast, so the
# "expected kWh today" used to reduce overnight charging on sunny days comes from the free
# forecast.solar API. Leave LAT/LON blank to disable (system then charges to base targets).
# AZIMUTH: -90=East, 0=South, 90=West. KWP defaults to the plant's 9.3 kWp nominal PV power.
SOLAR_FORECAST_LAT=
SOLAR_FORECAST_LON=
SOLAR_FORECAST_DECLINATION=35
SOLAR_FORECAST_AZIMUTH=0
SOLAR_FORECAST_KWP=9.3
# Optional % tuning for shading/soiling (100 = use as-is, 80 = reduce by 20%)
SOLAR_FORECAST_MULTIPLIER=100

# Octopus Go Configuration
OCTOPUS_GO_ENABLED=true
# Times are always in GMT (UTC), regardless of local time zone or BST/DST
OCTOPUS_GO_START_TIME=00:30
OCTOPUS_GO_END_TIME=05:30
OCTOPUS_GO_RATE=8.5

# Battery Configuration
# Monthly morning target SOC (excludes predicted generation) - ensures minimum charge for daily use
# CSV format: Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec
# Higher targets in winter months (Oct-Mar) for reduced solar generation
OCTOPUS_GO_MORNING_TARGET_SOC=45,45,45,30,30,30,30,30,30,45,45,45
# Monthly evening target SOC (includes predicted generation adjustment) - ensures charge for overnight/next morning  
# CSV format: Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec
# Higher targets in winter months (Oct-Mar) for increased heating/lighting demand
OCTOPUS_GO_EVENING_TARGET_SOC=60,60,60,55,55,55,55,55,55,60,60,60

# Consumption thresholds (watts)
# Don't start charging if consumption exceeds this threshold
CONSUMPTION_START_THRESHOLD=3000
# Stop charging if consumption exceeds this threshold (higher than start to account for charging load)
CONSUMPTION_STOP_THRESHOLD=6000

# Email notifications
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@gmail.com

# Legacy Agile settings (still used when Octopus Go is disabled)
CHEAP_PERCENTILE=25
MODERATE_PERCENTILE=25
CHEAP_THRESHOLD=60
CHEAP_DIFFERENCE=0.1
MODERATE_THRESHOLD=30
# --- EV overnight top-up (ev-forecast.js) ---
# Pre-store the expected morning EV draw in the battery overnight at cheap rate, so the
# morning car charge isn't bought at peak. Draw is estimated from historical consumption in
# ev-samples.csv (sustained load above EV_DETECT_W, capped at the car's EV_CHARGE_RATE_W).
OCTOPUS_GO_EV_TOPUP_ENABLED=false
# Seasonal scaling 0-100% per month (Jan..Dec): winter-high (no solar recovery), summer-low
# (daytime solar refills the battery cheaply after the morning draw).
OCTOPUS_GO_EV_TOPUP_FACTOR=100,90,80,60,40,30,30,40,60,80,90,100
# Optional tuning (defaults shown):
# EV_TOPUP_WINDOW_DAYS=14      rolling history window
# EV_TOPUP_MAX_PCT=40          hard cap on the added %
# EV_DETECT_W=3000             consumption above this = EV likely charging
# EV_CHARGE_RATE_W=3700        per-sample EV share cap (the car's charge rate)
# EV_BASELINE_W=700            assumed house baseline load
